{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=pharmacast_db;Username=postgres;Password=YOUR_DB_PASSWORD"
  },
  "Jwt": {
    "Secret": "YOUR_JWT_SECRET_HERE",
    "Issuer": "PharmacyApiService",
    "Audience": "PharmacyApiServiceClients",
    "ExpirationMinutes": 60,
    "RefreshTokenDays": 7
  },
  "AzureBlob": {
    "ConnectionString": "YOUR_AZURE_BLOB_CONNECTION_STRING",
    "BaseUrl": "YOUR_AZURE_BLOB_BASE_URL"
  },
  "MLService": {
    "BaseUrl": ""
  }
}
